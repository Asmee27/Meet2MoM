# ============================================
# Meet2MoM - Environment Configuration
# ============================================

# -----------------------------
# Application
# -----------------------------

APP_NAME=Meet2MoM
APP_ENV=development

HOST=127.0.0.1
PORT=8000


# -----------------------------
# Frontend
# -----------------------------

FRONTEND_URL=http://localhost:5173


# -----------------------------
# Hugging Face
# Required for pyannote diarization
# -----------------------------

HUGGINGFACE_TOKEN=your_huggingface_token_here


# -----------------------------
# ASR Configuration
# -----------------------------

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8


# -----------------------------
# Pipeline
# -----------------------------

ENABLE_PIPELINE_CACHE=true
CACHE_TRANSCRIPTION=true
CACHE_DIARIZATION=true


# -----------------------------
# Future LLM / RAG Integration
# Leave empty until configured
# -----------------------------

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=