# ============================================
# Meet2MoM - Environment Configuration Example
# ============================================

# -----------------------------
# Application Server
# -----------------------------
APP_NAME=Meet2MoM
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# -----------------------------
# Frontend
# -----------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------
# Hugging Face
# Required for pyannote diarization (read in app/services/diarization/diarizer.py)
# -----------------------------
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# -----------------------------
# Meeting ID Overrides (Optional)
# Used in app/core/config.py and scripts/run_recorded_pipeline.py
# If unset, an isolated UUID is generated automatically per meeting.
# -----------------------------
MEETING_ID=
MEET2MOM_MEETING_ID=

# -----------------------------
# ASR Configuration
# -----------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# -----------------------------
# Pipeline Caching
# -----------------------------
ENABLE_PIPELINE_CACHE=true
CACHE_TRANSCRIPTION=true
CACHE_DIARIZATION=true

# -----------------------------
# LLM / Extraction Configuration
# Providers: stub, openai, anthropic, local
# Extractors: llm, rules
# -----------------------------
LLM_PROVIDER=stub
LLM_MODEL=mock-v1
LLM_API_KEY=
LLM_BASE_URL=
EXTRACTOR=llm

# -----------------------------
# Future LLM / RAG Integration
# Leave empty until configured
# -----------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=