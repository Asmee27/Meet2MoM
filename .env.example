# ============================================
# Meet2MoM - Environment Configuration Example
# ============================================
# Copy to .env in the repository root and fill in your own values.
# Never commit .env. Put every setting on its own line.
#
# Loading: app/core/config.py reads .env once, when the API, the worker or the
# pipeline subprocess starts (python-dotenv, override=False). Variables already
# set in the shell win over .env. After editing .env, restart the API (and
# scripts/worker.py when JOB_RUNNER=worker).

# -----------------------------
# LiveKit (live meetings)
# Server URL and API credentials from your LiveKit project
# (read in app/core/config.py, used by app/services/live/)
# -----------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------
# Hugging Face
# Required for pyannote diarization of uploaded recordings. Accept the
# pyannote/speaker-diarization-community-1 conditions first. Either name works.
# -----------------------------
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_TOKEN=

# -----------------------------
# Speech recognition (faster-whisper)
# The defaults are the benchmarked setup (docs/benchmarks/phase3_rtf.md).
# -----------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Spoken language (en, hi, mr, ...). Empty = automatic detection per track,
# which costs about 14 s per participant track on a 2-core laptop. Set it when
# every meeting is in one language (docs/phase-6/PHASE_6_PROCESSING_SPEED.md).
WHISPER_LANGUAGE=
# Decoding hint given to Whisper: none (default), language, or vocabulary.
# "vocabulary" lists technical terms and can turn an unclear word into one of
# them (e.g. "by Friday" heard as "by FFmpeg"), so it is off by default.
WHISPER_PROMPT=none
# Split a Whisper segment where the pause between two words exceeds this many
# seconds, so one segment never spans someone else's speech.
WHISPER_SPLIT_GAP_SECONDS=1.5

# -----------------------------
# Pipeline caching (true/false)
# Reuses ASR and diarization results for an unchanged recording.
# -----------------------------
ENABLE_PIPELINE_CACHE=true
CACHE_TRANSCRIPTION=true
CACHE_DIARIZATION=true

# -----------------------------
# Processing jobs
# inline: the API runs each job itself (default; do NOT start scripts/worker.py).
# worker: the API only queues jobs; run scripts/worker.py with the same setting.
# -----------------------------
JOB_RUNNER=inline
# Where audio, ASR and speaker attribution run:
#   auto (default): in-process inside scripts/worker.py (models stay loaded
#     between meetings), a fresh subprocess per meeting in the API process
#   inprocess / subprocess: force one or the other
SPEECH_PIPELINE=auto
# Load Whisper, pyannote, embeddings and NLI when the worker starts.
WORKER_PRELOAD_MODELS=true
# Optional: keep all meeting data and the database somewhere else
# (default: storage/ in this repository).
#   MEET2MOM_STORAGE_ROOT=D:\meet2mom-data

# -----------------------------
# Accounts (Phase 7)
# true (default): email/password sign-in; meetings are visible to members only.
# false: local single-user demo mode without sign-in.
# -----------------------------
AUTH_REQUIRED=true
# Set to true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# -----------------------------
# Email (Phase 8.4): invitations and approved minutes
# EMAIL_PROVIDER: console (default, development mode: nothing is sent, the UI
#   says so) or brevo (Brevo transactional API).
# BREVO_API_KEY: Brevo > SMTP & API > API keys. Never commit it.
# EMAIL_SENDER_ADDRESS: a sender verified in Brevo (Senders, Domains &
#   Dedicated IPs). Authenticate the domain (DKIM/DMARC) for real delivery.
# BREVO_WEBHOOK_TOKEN: a long random string; configure the Brevo transactional
#   webhook to send it as header X-Meet2MoM-Webhook-Token. Without it, statuses
#   stop at "sent to provider" (delivered/bounced are never assumed).
# PUBLIC_APP_URL: where people open links (the frontend), used in emails.
# EMAIL_DISPATCH: api (default; the API sends in the background), worker
#   (scripts/worker.py sends), or off.
# See docs/phase-8/PHASE_8_4_EMAIL.md.
# -----------------------------
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Meet2MoM
BREVO_WEBHOOK_TOKEN=
PUBLIC_APP_URL=http://localhost:5173
EMAIL_DISPATCH=api
EMAIL_TIMEOUT_SECONDS=15
EMAIL_MAX_ATTEMPTS=4

# -----------------------------
# LLM / Extraction Configuration
# See docs/phase-4/LLM_EXTRACTION.md
#
# LLM_PROVIDER: gemini (recommended), openai, anthropic, local, stub
#   stub is a test fixture only; with stub, meetings use the local fallback.
# LLM_MODEL: required for openai/anthropic/local; gemini defaults to
#   gemini-3.8-flash when left as mock-v1 or empty. Set e.g.
#   LLM_MODEL=gemini-3.6-flash to override it.
# API key: LLM_API_KEY, or the provider's own variable below.
# EXTRACTOR: llm (LLM with automatic local fallback), hybrid, dialogue, rules
# FALLBACK_EXTRACTOR: local extractor used when the LLM is unavailable/fails
# Timeouts: LLM_TIMEOUT_SECONDS per request, LLM_TIMEOUT_RETRIES extra tries
#   after a timeout, LLM_EXTRACTION_BUDGET_SECONDS cap on all LLM calls for one
#   meeting (0 = no cap).
# Check the configuration without printing the key:
#   python scripts/check_llm.py
# -----------------------------
LLM_PROVIDER=stub
LLM_MODEL=mock-v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=180
LLM_TIMEOUT_RETRIES=1
LLM_EXTRACTION_BUDGET_SECONDS=600
EXTRACTOR=llm
FALLBACK_EXTRACTOR=hybrid

# Provider-specific keys (used when LLM_API_KEY is empty). Never commit real keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------
# Topic titles
# extractive (default) or llm. LLM titles must use words from the topic's own
# utterances; otherwise, and whenever the LLM is unavailable, the extractive
# title is used and the reason is recorded on the topic.
# -----------------------------
TOPIC_TITLES=extractive
TOPIC_TITLE_LLM_BUDGET_SECONDS=60

# -----------------------------
# Frontend API address (optional)
# Vite reads this from frontend/.env, NOT from this file. The default is the
# local API on port 8000.
#   VITE_API_BASE_URL=http://127.0.0.1:8000
# -----------------------------

# -----------------------------
# Internal (leave empty)
# MEETING_ID / MEET2MOM_MEETING_ID are set per meeting for the pipeline
# subprocess. A value here would send every CLI run to the same folder.
# -----------------------------
MEETING_ID=
MEET2MOM_MEETING_ID=
